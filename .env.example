# Ключ шифрования cookie-сессии. Обязателен в production.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Origin'ы фронтенда через запятую. Пусто = разрешить все (только для разработки).
ALLOWED_ORIGINS=http://localhost:5173

# Application key Journal. Переопределять обычно не нужно.
APPLICATION_KEY=
